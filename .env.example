# Leave both empty to use the clearly marked, local demonstration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional Cloudflare Turnstile site key, after enabling it in Supabase Auth.
VITE_TURNSTILE_SITE_KEY=

# link uses the default Supabase email; code requires configured OTP templates.
VITE_AUTH_EMAIL_MODE=code
# Enable only after configuring the Google provider.
VITE_GOOGLE_AUTH_ENABLED=false
